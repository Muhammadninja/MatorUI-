# Public mobile configuration only. Never add credentials to EXPO_PUBLIC_*.
# Use `node scripts/app-environment.cjs local` for isolated local development.
# Use `node scripts/app-environment.cjs production` for a production API dev session.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3300
# Empty enables real HTTP for every domain, including legal and shipping.
EXPO_PUBLIC_HTTP_DOMAINS=
# Only accepted for development builds + local loopback API.
EXPO_PUBLIC_ALLOW_DEV_OTP=true
EXPO_PUBLIC_SENTRY_DSN=
