# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude tooling — runtime state, locally-installed skills, agent memory db.
# The agent/command/helper definitions under .claude/ stay tracked; only the
# noise that auto-updates as the daemon runs is excluded here.
.claude/skills/
.claude/memory.db
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/metrics/
