# Install as /etc/mator/vehicle-images.env with owner-only permissions (chmod 600).
# Use a separate, least-privilege API credential. Never commit the populated file.
VEHICLE_IMAGE_ADMIN_TOKEN=replace-with-at-least-32-random-characters
VEHICLE_IMAGE_REQUEST_TOKEN=replace-with-a-different-32-character-server-to-server-token
VEHICLE_IMAGE_DATA_DIR=/var/lib/mator-vehicle-images
PORT=8047
VEHICLE_IMAGE_GENERATION_ENABLED=false
# Daily hard ceiling on provider call attempts, including retries. This limits calls, not exact spend.
VEHICLE_IMAGE_MAX_PROVIDER_CALLS_PER_DAY=10
# Leave false in isolated staging; credentials are not required while disabled.
VEHICLE_IMAGE_PUBLICATION_ENABLED=false
# Provider settings are unused while generation is false.
VEHICLE_IMAGE_PROVIDER=openai
VEHICLE_IMAGE_MODEL=approved-image-model-id
# Required only after separately authorizing paid generation.
OPENAI_API_KEY=server-side-secret
# Configure only when publication is explicitly enabled.
# CLOUDINARY_CLOUD_NAME=cloud-name
# CLOUDINARY_API_KEY=api-key
# CLOUDINARY_API_SECRET=server-side-secret
# Free repository artwork (assets/vehicles/...) becomes PRIVATE candidates for review.
# Set to false to disable; it never publishes anything by itself.
VEHICLE_IMAGE_REPOSITORY_ARTWORK_ENABLED=true
# External source is opt-in; Commons images are private candidates and always need review.
VEHICLE_IMAGE_WIKIMEDIA_ENABLED=false
VEHICLE_IMAGE_WIKIMEDIA_USER_AGENT=MatorVehicleImagePipeline/1.0 (https://mator.uz)
# Optional comma-separated one-candidate restriction for a controlled publication test.
VEHICLE_IMAGE_PUBLICATION_CANDIDATE_ALLOWLIST=
# Defaults to the checkout root; must contain assets/vehicles/.
# VEHICLE_IMAGE_ARTWORK_ROOT=/opt/mator/vehicle-image-pipeline
# Paid generation for identities the registry does not verify stays off unless separately approved.
VEHICLE_IMAGE_ALLOW_UNVERIFIED_GENERATION=false
# true: generation runs before repository artwork and Commons photos (they become the fallback).
VEHICLE_IMAGE_GENERATION_FIRST=false
# Optional approved image every generation copies for angle, framing and light (never the car).
# VEHICLE_IMAGE_STYLE_REFERENCE=assets/vehicles/chevrolet/cobalt-gen2/white.webp
# cloudinary (default) or local. local writes immutable files and serves them at GET /assets/...
# VEHICLE_IMAGE_STORE=local
# VEHICLE_IMAGE_LOCAL_STORE_DIR=/var/lib/mator-vehicle-images/published
# VEHICLE_IMAGE_PUBLIC_BASE_URL=https://images.example/assets
