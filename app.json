{
  "expo": {
    "name": "Mator",
    "slug": "Mator",
    "owner": "matoruz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image.png",
    "scheme": "mator",
    "userInterfaceStyle": "automatic",
    "buildCacheProvider": "eas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fotih12.mator",
      "icon": "./assets/image.png",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "DXP9AG6TPN"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/image.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fotih12.mator"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F2F3F5",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "llc-mator-innovations",
          "project": "apple-ios",
          "url": "https://sentry.io/"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e4e8419-ba28-4fe4-b4af-953729419716"
      },
      "sentry": {
        "dsn": "https://20afea744b5f75def4c8d2f6ffd9c1d2@o4511632480141312.ingest.us.sentry.io/4511632482631680",
        "environment": "production",
        "enableInDev": false
      }
    }
  }
}
