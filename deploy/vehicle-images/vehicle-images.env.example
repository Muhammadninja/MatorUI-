# Install as /etc/mator/vehicle-images.env with owner-only permissions (chmod 600).
# Use a separate, least-privilege API credential. Never commit the populated file.
VEHICLE_IMAGE_ADMIN_TOKEN=replace-with-at-least-32-random-characters
VEHICLE_IMAGE_REQUEST_TOKEN=replace-with-a-different-32-character-server-to-server-token
VEHICLE_IMAGE_DATA_DIR=/var/lib/mator-vehicle-images
PORT=8047
VEHICLE_IMAGE_GENERATION_ENABLED=false
# Leave false in isolated staging; credentials are not required while disabled.
VEHICLE_IMAGE_CLOUDINARY_PUBLICATION_ENABLED=false
# Provider settings are unused while generation is false.
VEHICLE_IMAGE_PROVIDER=openai
VEHICLE_IMAGE_MODEL=approved-image-model-id
# Required only after separately authorizing paid generation.
OPENAI_API_KEY=server-side-secret
# Configure only when publication is explicitly enabled.
# CLOUDINARY_CLOUD_NAME=cloud-name
# CLOUDINARY_API_KEY=api-key
# CLOUDINARY_API_SECRET=server-side-secret
