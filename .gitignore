# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Store submission credentials — never commit
google-play-service-account.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env*.local

# Maestro E2E run output (screenshots, junit reports)
/artifacts
maestro-report.xml
mock.log

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# ruflo vector store — a local tool artifact, ~1.5 MB of binary that churns
# on every run. Kept on disk, out of the repo.
ruvector.db

# Claude tooling — runtime state, locally-installed skills, agent memory db.
# The agent/command/helper definitions under .claude/ stay tracked; only the
# noise that auto-updates as the daemon runs is excluded here.
.claude/skills/
.claude/memory.db
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/metrics/


.npm-global/
# Isolated local integration databases, private runtime config and logs
/.local/
