# Install as /etc/mator/vehicle-images-staging.env with owner-only permissions.
# Generate independent random tokens for this staging-only service.
VEHICLE_IMAGE_ADMIN_TOKEN=replace-with-a-random-staging-admin-token
VEHICLE_IMAGE_REQUEST_TOKEN=replace-with-a-different-random-staging-request-token
VEHICLE_IMAGE_DATA_DIR=/var/lib/mator-vehicle-images-staging
PORT=8048
VEHICLE_IMAGE_ENVIRONMENT=staging
VEHICLE_IMAGE_CLOUDINARY_PUBLIC_ID_PREFIX=mator/vehicle-images-staging
VEHICLE_IMAGE_GENERATION_ENABLED=false
VEHICLE_IMAGE_PUBLICATION_ENABLED=false
VEHICLE_IMAGE_REPOSITORY_ARTWORK_ENABLED=true
VEHICLE_IMAGE_ALLOW_UNVERIFIED_GENERATION=false
