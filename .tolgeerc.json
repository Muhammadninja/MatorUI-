{
  "$schema": "https://tolgee.io/cli-schema.json",
  "apiUrl": "https://app.tolgee.io",
  "projectId": 0,
  "format": "JSON_I18NEXT",
  "push": {
    "files": [
      { "path": "./locales/en.json", "language": "en" },
      { "path": "./locales/ru.json", "language": "ru" },
      { "path": "./locales/uz.json", "language": "uz" }
    ],
    "forceMode": "OVERRIDE"
  },
  "pull": {
    "path": "./locales",
    "languages": ["en", "ru", "uz"]
  }
}
