{
  "expo": {
    "name": "Mator",
    "slug": "Mator",
    "owner": "matoruz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/MATOR-app-icons/expo/icon.png",
    "scheme": "mator",
    "userInterfaceStyle": "automatic",
    "buildCacheProvider": "eas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fotih12.mator",
      "icon": {
        "light": "./assets/MATOR-app-icons/expo/icon-light.png",
        "dark": "./assets/MATOR-app-icons/expo/icon.png",
        "tinted": "./assets/MATOR-app-icons/expo/adaptive-icon.png"
      },
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Mator uses the camera to scan your vehicle's VIN and take photos for your profile.",
        "NSPhotoLibraryUsageDescription": "Mator needs access to your photos so you can set a profile picture and attach images.",
        "NSLocationWhenInUseUsageDescription": "Mator uses your location to find nearby parts providers and mechanics.",
        "NSFaceIDUsageDescription": "Mator uses Face ID to securely sign you in to your account.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "138.68.70.45": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "appleTeamId": "DXP9AG6TPN"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.mator.myapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/MATOR-app-icons/expo/adaptive-icon.png",
        "monochromeImage": "./assets/MATOR-app-icons/expo/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/MATOR-app-icons/expo/splash-icon-dark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/MATOR-app-icons/expo/splash-icon.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "llc-mator-innovations",
          "project": "apple-ios",
          "url": "https://sentry.io/"
        }
      ],
      "@sentry/react-native",
      "./plugins/with-jitpack-scoping"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e4e8419-ba28-4fe4-b4af-953729419716"
      },
      "sentry": {
        "dsn": "https://20afea744b5f75def4c8d2f6ffd9c1d2@o4511632480141312.ingest.us.sentry.io/4511632482631680",
        "environment": "production",
        "enableInDev": false
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1e4e8419-ba28-4fe4-b4af-953729419716"
    }
  }
}
